PORT=8080
NODE_ENV=development

# Optional. Without it only /api/market/* is disabled (503), never the whole API.
LSE_API_KEY=your_lse_api_key_here

# Postgres connection string (Neon). Used by /api/workspace.
# On Vercel this is provided automatically by the Neon integration.
DATABASE_URL=postgresql://user:password@host/database
